# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: HMAC signing key for HTTP-only authentication cookies (auto-generated fallback in dev).
SESSION_SECRET="REPLACE_WITH_SECURE_RANDOM_STRING"

# ADMIN_EMAIL: Optional email address granted administrator privileges on signup/login.
ADMIN_EMAIL=""

# SPOTIFY_CLIENT_ID / SPOTIFY_CLIENT_SECRET: Optional Spotify Web API credentials for expanded metadata.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key for live YouTube search (Official YouTube embeds work without key).
YOUTUBE_API_KEY=""
